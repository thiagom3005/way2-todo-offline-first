# Copie para .env para sobrescrever os padrões de desenvolvimento do docker-compose.yml.
# Nunca versione o .env. Valores abaixo são exclusivamente para ambiente local.
POSTGRES_DB=way2_todo
POSTGRES_USER=way2
POSTGRES_PASSWORD=way2_dev_only
POSTGRES_PORT=5433

API_PORT=5080
# Frontend de produção (nginx + Service Worker).
WEB_PORT=4280
# Rede do compose: o IP fixo do nginx é o único proxy em que a API confia para X-Forwarded-For.
# Ajuste os dois juntos se a sub-rede colidir com outra rede Docker ou da sua máquina.
COMPOSE_SUBNET=172.30.240.0/24
WEB_PROXY_IP=172.30.240.10
# Webhooks: segredo HMAC compartilhado entre a API e o consumidor (mínimo 32 bytes).
WEBHOOK_SECRET=dev-only-webhook-secret-do-not-use-in-production-0123456789
# Painel do consumidor simulado (publicado só em 127.0.0.1).
CONSUMER_PORT=5090
# Chave HMAC do JWT (mínimo 32 bytes). Em produção, injetar por secret manager.
JWT_SIGNING_KEY=dev-only-signing-key-do-not-use-in-production-0123456789
# Usuários demo@way2.local e demo2@way2.local (somente para demonstração).
DEMO_SEED_ENABLED=true
DEMO_PASSWORD=Way2Demo!2026
